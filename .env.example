# MENUREST.UZ Muhit O'zgaruvchilari Namunasi (.env.example)
# Haqiqiy maxfiy kalitlarni ushbu faylga kiritmang!

# Portlar
PORT=4000
WEB_PORT=3000

# Ma'lumotlar bazasi (PostgreSQL)
# Standart lokal yoki Docker ulanish manzili
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menurest_v2?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menurest_v2_test?schema=public"

# JWT va Xavfsizlik
JWT_SECRET="demo-secret-replace-in-production-min-32-chars-long"
JWT_EXPIRES_IN="1d"
GUEST_JWT_SECRET="demo-guest-secret-replace-in-production-min-32-chars"
GUEST_JWT_EXPIRES_IN="12h"

# Ilova sozlamalari
NODE_ENV="development"
TIMEZONE="Asia/Tashkent"
CURRENCY="UZS"
