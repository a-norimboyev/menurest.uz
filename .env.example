# MENUREST.UZ Environment Variables Template
# Copy this file to .env and configure values before starting the application.

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication (Replace with high-entropy secret in production)
JWT_SECRET=your-random-32-byte-hex-jwt-secret-placeholder

# Database Connection (SQLite for local dev, PostgreSQL for production deployment)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/menurest_prod?schema=public"
