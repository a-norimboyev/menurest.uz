# Telegram bot token (@BotFather dan oling)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL (backend bilan bir xil)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Ruxsat berilgan Telegram user ID (xavfsizlik uchun)
ALLOWED_USER_ID=

# Sync user ID (frontend bilan bir xil)
SYNC_USER_ID=azizjon-365-sync
